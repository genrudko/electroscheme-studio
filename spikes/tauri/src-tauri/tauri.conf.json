{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ElectroScheme Tauri Spike",
  "version": "0.1.0",
  "identifier": "dev.electroscheme.desktopspike",
  "build": {
    "frontendDist": "../../shared/ui/dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "title": "ElectroScheme Tauri Spike",
        "width": 1000,
        "height": 700
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
